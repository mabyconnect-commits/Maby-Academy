# ---------------------------------------------------------------------------
# Maby Academy — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://maby:maby@127.0.0.1:5432/maby_academy?schema=public"

# Public origin of the app. Used for certificate verification links,
# referral links and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32+ character secret used to sign/hash session tokens at rest.
# Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in days.
SESSION_TTL_DAYS="30"

# Referral commission rates per level, comma separated, as decimals.
# Example "0.10,0.05,0.02" = 10% level 1, 5% level 2, 2% level 3.
REFERRAL_COMMISSION_RATES="0.10,0.05,0.02"
