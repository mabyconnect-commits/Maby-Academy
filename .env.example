# ---------------------------------------------------------------------------
# Maby Academy — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the running app.
# On serverless (Vercel) this MUST be a pooled connection string — every
# function instance opens its own connection. Neon/Supabase give you a
# "pooled" or "-pooler" URL; self-hosted means PgBouncer.
DATABASE_URL="postgresql://maby:maby@127.0.0.1:5432/maby_academy?schema=public"

# Direct (unpooled) connection, used only by `prisma migrate`.
# Locally this is the same as DATABASE_URL. In production it is the
# non-pooled variant of the same database.
DIRECT_DATABASE_URL="postgresql://maby:maby@127.0.0.1:5432/maby_academy?schema=public"

# Public origin of the app. Used for certificate verification links,
# referral links and email links. Must be the real domain in production —
# certificates print this URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32+ character secret used to sign/hash session tokens at rest.
# Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in days.
SESSION_TTL_DAYS="30"

# Referral commission rates per level, comma separated, as decimals.
# Example "0.10,0.05,0.02" = 10% level 1, 5% level 2, 2% level 3.
# Commissions are ALSO gated by the `referral_commissions` feature flag,
# which is off by default pending compliance review.
REFERRAL_COMMISSION_RATES="0.10,0.05,0.02"

# ---------------------------------------------------------------------------
# Payments — Flutterwave
#
# Dashboard → Settings → API Keys. Use TEST keys until you are ready to
# charge real money; test keys begin FLWSECK_TEST-.
#
# Without these, the academy still runs: paid courses simply cannot be
# purchased, and the enrol button says so rather than erroring.
# ---------------------------------------------------------------------------

# Secret key — server-side only, never expose to the browser.
FLUTTERWAVE_SECRET_KEY=""

# Public key. Not currently required by the hosted-checkout flow, but kept
# here for the inline/embedded checkout if you switch to it later.
FLUTTERWAVE_PUBLIC_KEY=""

# Webhook secret hash. Set the SAME value in
# Flutterwave dashboard → Settings → Webhooks → "Secret hash".
# Every webhook is rejected unless its `verif-hash` header matches this, so
# leaving it blank means no webhook is ever trusted.
FLUTTERWAVE_SECRET_HASH=""
